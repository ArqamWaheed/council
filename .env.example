# Council configuration — copy to .env and fill in (or leave blank to run in offline mock mode)

# Free OpenRouter API key (https://openrouter.ai — no credit card required)
OPENROUTER_API_KEY=

# Two free jurors from DIFFERENT model families (>=64K context). The :free suffix keeps cost $0.
# Free models are heavily rate-limited upstream; if one 429s, Council retries then falls back to mock.
JUROR_1_MODEL=openai/gpt-oss-120b:free
JUROR_2_MODEL=z-ai/glm-4.5-air:free

# Optional local "on-device" juror via Ollama. Leave OLLAMA_MODEL blank to skip it.
# Pull one first, e.g.: ollama pull qwen2.5
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1

# The model Hermes uses to synthesize the verdict (judge). Falls back to JUROR_1_MODEL if blank.
JUDGE_MODEL=
